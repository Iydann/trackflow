# Model Configuration
# Available models (sorted by accuracy):
# - yolov8n.pt: Nano (6MB, fastest, least accurate)
# - yolov8s.pt: Small (22MB, fast, good accuracy)
# - yolov8m.pt: Medium (52MB, balanced)
# - yolov8l.pt: Large (103MB, slow, very accurate)
# - yolov8x.pt: XLarge (136MB, slowest, most accurate)
MODEL_NAME=yolov8m.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.5

# Vehicle Classes (COCO dataset indices)
# 2: car, 3: motorcycle, 5: bus, 7: truck
VEHICLE_CLASSES=2,3,5,7

# Processing Settings
MAX_VIDEO_SIZE_MB=500
SUPPORTED_FORMATS=mp4,avi,mov,mkv

# Output Settings
OUTPUT_DIR=./outputs
SAVE_FRAMES=false
FRAME_SKIP=1

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
